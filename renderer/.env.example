# ---- Kids Shorts AI — FFmpeg Renderer -------------------------------------
# Copy to .env and fill in. Only these three groups need changing.

# 1) Shared secret. Must be IDENTICAL to FFMPEG_WORKER_TOKEN in Kids Shorts AI.
#    Generate with: openssl rand -hex 32
RENDERER_API_KEY=change-me

# 2) Port the service listens on (also the published port in docker-compose).
RENDERER_PORT=8080

# 3) Storage configuration.
#    STORAGE_DRIVER=local  -> finished MP4s are served by this service itself
#    STORAGE_DRIVER=s3     -> finished MP4s are uploaded to S3/R2/Spaces
STORAGE_DRIVER=local

# Public base URL of this service, used to build downloadable MP4 links.
# Required for STORAGE_DRIVER=local. Example: https://render.example.com
PUBLIC_BASE_URL=http://localhost:8080

# Where jobs, working files and finished videos live (mounted volume in Docker).
DATA_DIR=/data

# --- S3-compatible storage (only when STORAGE_DRIVER=s3) -------------------
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=kids-shorts-renders
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=https://cdn.example.com

# --- Tuning (safe defaults) ------------------------------------------------
# MAX_CONCURRENT_RENDERS=1
# JOB_RETENTION_HOURS=48
# FILE_RETENTION_HOURS=24
